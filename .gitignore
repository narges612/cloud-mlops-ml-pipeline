```gitignore
# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environment
.venv/
venv/

# Environment variables and secrets
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/

# ML experiments and artifacts
mlruns/
mlartifacts/
artifacts/
mlflow.db

# Local data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# OS and editor
.DS_Store
.vscode/

# Local model artifacts
models/local/
```
